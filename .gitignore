# Publication allowlist. Local QA builds, saves, research and operational receipts stay private.
/*
!/.gitignore
!/LICENSE
!/README.md
!/THIRD_PARTY_NOTICES.md
!/Browser/
!/Web/
!/Contracts/
!/Tests/
!/Tools/
!/Local/
/Local/*
!/Local/catalogue_shell.py
!/Local/catalogue-shell.css
!/Local/character-catalogue/
!/Local/ship-catalogue/
!/Local/goods-catalogue/
!/Local/guide-catalogue/
!/Balance/
/Balance/*
!/Balance/current.json
!/Balance/README.md
!/Balance/approved-v95/
!/.github/
**/.DS_Store
**/.env*
**/node_modules/
**/target/
**/cache/
**/out/
**/__pycache__/
**/*.pyc
**/.vercel/
**/actions.sqlite3*
**/voyage.json
**/checkpoint.json
**/slot[123].json
/Web/dist/
/Contracts/lib/
